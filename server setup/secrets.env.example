# Copy to /etc/stonesage/secrets.env on each host (chmod 600, owned by root).
# systemd units load it via: EnvironmentFile=-/etc/stonesage/secrets.env
# Never commit the real file.
HASS_URL=http://192.168.1.82:8123
HASS_TOKEN=
PVE_TOKEN=PVEAPIToken=USER@pam!TOKENID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
COUCHDB_URL=http://192.168.1.230:5984
COUCHDB_USER=
COUCHDB_PASSWORD=
POSTGRES_URL=
# Frigate (LXC on pve). Tapo "camera account" (Tapo app > camera > Advanced > Camera Account),
# and the HA user created for Mosquitto. Frigate only substitutes variables named FRIGATE_*.
FRIGATE_TAPO_USER=
FRIGATE_TAPO_PASSWORD=
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=
