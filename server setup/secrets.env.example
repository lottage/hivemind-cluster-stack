# Copy to /etc/stonesage/secrets.env on each host (chmod 600, owned by root).
# systemd units load it via: EnvironmentFile=-/etc/stonesage/secrets.env
# Never commit the real file.
HASS_URL=http://192.168.1.82:8123
HASS_TOKEN=
PVE_TOKEN=PVEAPIToken=USER@pam!TOKENID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
COUCHDB_URL=http://192.168.1.230:5984
COUCHDB_USER=
COUCHDB_PASSWORD=
POSTGRES_URL=
# Frigate (LXC on pve). Tapo "camera account" (Tapo app > camera > Advanced > Camera Account),
# and the HA user created for Mosquitto. Frigate only substitutes variables named FRIGATE_*.
FRIGATE_TAPO_USER=
FRIGATE_TAPO_PASSWORD=
# TP-Link cloud account password (the Tapo app login), for go2rtc tapo:// on cameras without RTSP.
# URL-encode it if it contains @ : / ? # % or spaces.
FRIGATE_TAPO_CLOUD_PASSWORD=
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=
# Boost: free inference keys (LXC 120, loaded by stonesage.service). Free tiers only, no card needed.
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GEMINI_API_KEY=
OPENCODE_API_KEY=
OPENROUTER_API_KEY=
# Shared with the frontier worker on VM 102. There it lives in /etc/frontier-worker/token.env, NOT in this file:
# the Claude/Gemini CLIs must never see HASS_TOKEN.
FRONTIER_WORKER_TOKEN=
