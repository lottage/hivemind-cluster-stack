[Unit]
Description=Llama-Server Ornith-1.5-9B Q4_K_M Edge Worker (RX 6600 XT - ROCm/HIP)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/models
ExecStart=/usr/local/bin/llama-server-rocm \
    --model /opt/models/ornith-1.5-9b-worker-q4_k_m.gguf \
    --host 0.0.0.0 \
    --port 8002 \
    --device ROCm1 \
    -ngl 99 \
    -c 8192 \
    -np 2 \
    -b 2048 \
    -ub 512 \
    -t 8 \
    --flash-attn on \
    -ctk q4_0 \
    -ctv q4_0 \
    --alias worker \
    --metrics \
    --spec-type ngram-mod \
    --spec-ngram-mod-n-min 16 \
    --spec-ngram-mod-n-max 64 \
    --spec-ngram-mod-n-match 24

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
