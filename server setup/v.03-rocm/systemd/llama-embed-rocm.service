[Unit]
Description=Llama-Server Embedding Engine for Qdrant (RX 6600 XT - ROCm/HIP)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/models
ExecStart=/usr/local/bin/llama-server-rocm \
    --model /opt/models/bge-large-en-v1.5-f16.gguf \
    --host 0.0.0.0 \
    --port 8003 \
    --device ROCm1 \
    --embedding \
    -ngl 99 \
    -c 512 \
    --alias embedder

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
