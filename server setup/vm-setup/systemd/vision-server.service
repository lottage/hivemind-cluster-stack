[Unit]
Description=Llama Server Multimodal Vision Provider (Qwen2.5-VL-7B-Instruct on RX 6600 XT - Vulkan)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/models
Environment="GGML_VK_VISIBLE_DEVICES=1"
ExecStart=/usr/local/bin/llama-server \
    --model /opt/models/qwen2.5-vl-7b-instruct-q4_k_m.gguf \
    --mmproj /opt/models/mmproj-qwen2.5-vl-7b-f16.gguf \
    --host 0.0.0.0 \
    --port 8004 \
    --device Vulkan0 \
    -ngl 99 \
    -c 4096 \
    -np 1 \
    --alias vision \
    --metrics \
    --slots \
    --props
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
