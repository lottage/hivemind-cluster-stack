[Unit]
Description=Antigravity Cluster MCP SSE Bridge Server
After=network.target llama-coordinator.service llama-worker.service llama-embed.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cluster-bridge
Environment="COORDINATOR_URL=http://localhost:8001"
Environment="WORKER_URL=http://localhost:8002"
Environment="EMBED_URL=http://localhost:8003"
Environment="QDRANT_URL=http://192.168.1.112:6333"
Environment="HASS_URL=http://192.168.1.82:8123"
Environment="HASS_TOKEN="
Environment="FASTMCP_HOST=0.0.0.0"
Environment="FASTMCP_PORT=8765"
ExecStart=/opt/cluster-env/bin/python3 /opt/cluster-bridge/mcp_server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
