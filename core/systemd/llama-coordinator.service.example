[Unit]
Description=Llama Server Coordinator (Large Model / Reasoning Engine)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/models
ExecStart=/usr/local/bin/llama-server \
    -m /opt/models/coordinator-model.gguf \
    --port 8001 \
    --host 0.0.0.0 \
    --device Vulkan0 \
    -ngl 99 \
    -c 8192 \
    --flash-attn on \
    -ctk q4_0 -ctv q4_0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
