# Generate each with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
BRIDGE_PHONE_TOKEN=replace-me
BRIDGE_READ_TOKEN=replace-me
BRIDGE_PUBLISH_TOKEN=replace-me

BRIDGE_DB=/var/lib/watch-bridge/bridge.db
# Optional: StoneSage endpoint that receives replies (else StoneSage polls GET /events/{id})
STONESAGE_REPLY_WEBHOOK=http://127.0.0.1:8888/api/watch/reply

# Optional: Anthropic org usage. Admin keys require a Console organization.
ANTHROPIC_ADMIN_KEY=
MONTHLY_BUDGET_USD=50
COST_AMOUNT_DIVISOR=100
LOCAL_TZ=America/New_York

# Optional: llama-server instances started with --metrics (comma separated)
LLAMA_METRICS_URLS=http://10.0.0.21:8001/metrics,http://10.0.0.21:8002/metrics
USAGE_INTERVAL_S=300
